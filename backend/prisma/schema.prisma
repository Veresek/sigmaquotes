generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model quotes {
  id         Int       @id @default(autoincrement())
  author     String    @db.VarChar(100)
  content    String
  created_at DateTime? @default(now()) @db.Timestamp(6)
}
