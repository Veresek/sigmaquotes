generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model quotes {
  id         Int       @id @default(autoincrement())
  author     String    @db.VarChar(100)
  content    String
  created_at DateTime? @default(now()) @db.Timestamp(6)
}

model manifest {
  id         Int       @id @default(autoincrement())
  content    String
  created_at DateTime? @default(now()) @db.Timestamp(6)
}

model active_challenges {
  id        Int       @id @default(autoincrement())
  content   String
  author    String    @db.VarChar(100)
  start_at DateTime? @default(now()) @db.Timestamp(6)
  end_at   DateTime? @default(now()) @db.Timestamp(6)
}

model daily_challenges {
  id        Int       @id @default(autoincrement())
  content   String
}